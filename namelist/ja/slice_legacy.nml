! slice_plot 用 namelist : 旧コードと同じ図
!   上段: B (|Bz|, |B|) + 磁場ベクトル
!   下段: T = p/rho + 速度ベクトル
&slice
  diri = './',
  prefix = 'ju03nt', suffix = 'm.data',
  ntap = 0, nfiles = 1, nstep = 1, ndigit = 3,
  ! タイトル: title(i) を個別に書くか、下の自動タイトルを使う
  title_head = 'Dyn = 0.01 nPa, IMF = 0.105 nT, t =', t0 = 427.5, dt = 2.5, t_unit = ' h',
  header = 'High resolution Jovian Magnetosphere',
  psfile = 'zxju03nt00m.ps', ps_per_file = .false.,
  nx2 = 3002, ny2 = 2002, nz2 = 1002, nvar = 8, h = 0.15, nxp = 500,
  mirror_z = .true.,
  label_coord = 'jso',     ! 目盛は X=-x, Y=-y, Z=z (旧図のラベルと同じ向き)
  tick = 50.0
/
&panels
  npanel = 4,
  plane   = 'xz',     'yz',     'xz',      'yz',
  pos     = 0.0,      0.0,      0.0,       0.0,        ! y=0 面, x=0 面 [RJ]
  qty     = 'absbz',  'absb',   'temp',    'temp',
  vmin    = 0.0,      0.0,      0.0,       0.0,
  vmax    = 10.5,     10.5,     161.2,    161.2,     ! [nT] [nT] [eV] [eV]
  palette = 3,        3,        3,         3,
  nsmooth = 2,        2,        2,         2,
  vec     = 'b',      'b',      'v',       'v',
  vecmax  = 10.5,     10.5,     630.7,     630.7,      ! [nT] [nT] [km/s] [km/s]
  nvec_h  = 40,       20,       40,        20,
  nvec_v  = 20,       20,       20,        20,
  row     = 1,        1,        2,         2,
  col     = 1,        2,        1,         2,
  label   = 'B',      'B',      'T',       'T',
/

! ---- 物理単位 (全ツール共通, mhdunits)。色範囲などはこの単位で与える
!   n [cm^-3], v [km/s], p [nPa], B [nT], T [eV], J [uA/m^2], phi [kV], omega [1/s]
!   phys_units = .false. で規格化量のまま (旧ツールと同じ値)
&units
  phys_units = .true.,
  planet = 'jupiter',            ! 'jupiter' / 'saturn' / 'earth' / 'custom'
  !   各惑星版コードの規格化定数が既定値として入っている (距離の単位も RJ / RS / RE になる)
  !   jupiter: ns=1e10, bs=4.2e-4, xs=7.14e7,  vs=9.167e7, ts=0.779, ps=0.1403
  !   saturn : ns=1e10, bs=2.0e-5, xs=6.004e7, vs=4.359e6, ts=13.77, ps=3.185e-4
  !   earth  : ns=1e10, bs=3.12e-5, xs=6.378e6, vs=6.80e6, ts=0.937, ps=7.75e-4
  ! 値を変えるとき: 基本量 (数密度 [m^-3], 赤道表面の磁場 [T], 惑星半径 [m], イオン質量 [amu])
  !   を与えれば vs, ts, ps, temps は自動で計算する。導出量を個別に与えればその値を使う
  ! ns = 1.0e10, bs = 4.2e-4, xs = 7.14e7, ion_mass = 1.0,
  ! rhos = 1.67e-17, vs = 9.167e7, ts = 0.779, ps = 0.1403, temps = 8.76e7,
  ! length_unit = 'RJ',          ! 図の距離の単位
  temp_unit = 'eV'               ! 'eV', 'keV', 'K'
/
